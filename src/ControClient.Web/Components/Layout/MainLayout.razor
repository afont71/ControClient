@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/">ControClient</a>
        <nav class="app-nav">
            <a href="/clientes">Clientes</a>
            <a href="/buscar">Buscar</a>
            <a href="/boveda">Bóveda</a>
            <a href="/usuarios">Usuarios</a>
            <a href="/grupos">Grupos</a>
            <a href="/auditoria">Auditoría</a>
        </nav>
        <AuthorizeView>
            <Authorized>
                <span class="user">@context.User.Identity?.Name</span>
                <a class="logout" href="/logout">Salir</a>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .app-shell { min-height: 100vh; display: flex; flex-direction: column; }
    .app-header {
        display: flex; align-items: center; gap: 1.5rem;
        padding: .75rem 1.25rem; border-bottom: 1px solid #E1E7EF; background: #FFFFFF;
    }
    .brand { font-weight: 700; color: #006EB3; text-decoration: none; }
    .app-nav { display: flex; gap: 1rem; }
    .app-nav a { color: #1E2329; text-decoration: none; }
    .app-nav a:hover { color: #006EB3; }
    .user { margin-left: auto; color: #4B5563; font-size: .9rem; }
    .logout { color: #B00020; text-decoration: none; margin-left: .75rem; font-size: .9rem; }
    .app-main { padding: 1.25rem 1.5rem; flex: 1; }
</style>
