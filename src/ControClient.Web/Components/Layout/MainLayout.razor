@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject NavService Nav
@inject ControClient.Web.Security.VaultLockService Lock

<div class="app-shell">
    <aside class="app-sidebar">
        <a class="app-brand" href="/">
            <span class="logo">CC</span>
            ControClient
        </a>

        @if (_locked)
        {
            <div class="nav-section">Bóveda sellada</div>
            <nav class="app-nav">
                @if (_isAdmin)
                {
                    <NavLink href="/boveda">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke-linecap="round" /></svg>
                        Desellar bóveda
                    </NavLink>
                }
            </nav>
        }
        else
        {
        <div class="nav-section">Trabajo</div>
        <nav class="app-nav">
            <NavLink href="/clientes">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Clientes
            </NavLink>
            <NavLink href="/datos">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h10" stroke-linecap="round" /></svg>
                Datos
            </NavLink>
            <NavLink href="/vencimientos">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 11h18" stroke-linecap="round" /></svg>
                Vencimientos
            </NavLink>
            <NavLink href="/buscar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
                Buscar
            </NavLink>
        </nav>
        }

        @if (_isAdmin && !_locked)
        {
            <div class="nav-section">Administración</div>
            <nav class="app-nav">
                <NavLink href="/boveda">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke-linecap="round" /></svg>
                    Bóveda
                </NavLink>
                <NavLink href="/usuarios">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 20a6.4 6.4 0 0 0-2-4.6" stroke-linecap="round" /></svg>
                    Usuarios
                </NavLink>
                <NavLink href="/grupos">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="9" r="3" /><circle cx="16" cy="9" r="3" /><path d="M2.5 20a5.5 5.5 0 0 1 11 0M13 20a5.5 5.5 0 0 1 8.5-4.6" stroke-linecap="round" /></svg>
                    Grupos
                </NavLink>
                <NavLink href="/auditoria">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 3h14v18l-7-4-7 4V3Z" stroke-linejoin="round" /></svg>
                    Auditoría
                </NavLink>
                <NavLink href="/roles">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3Z" stroke-linejoin="round" /></svg>
                    Roles
                </NavLink>
                <NavLink href="/plantillas">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="4" width="17" height="16" rx="2" /><path d="M3.5 9h17M9 9v11" /></svg>
                    Tipos
                </NavLink>
            </nav>
        }

        <div class="sidebar-footer">Ideo Networks · Gestión de clientes IT</div>
    </aside>

    <div class="app-body">
        <header class="app-topbar">
            <span class="topbar-title">Gestión de clientes IT</span>
            <span class="spacer"></span>
            <AuthorizeView>
                <Authorized>
                    <span class="user-chip">
                        <span class="avatar">@InitialOf(context.User.Identity?.Name)</span>
                        @context.User.Identity?.Name
                    </span>
                    <a class="logout" href="/logout">Salir</a>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="app-main">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _isAdmin;
    private bool _locked;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await Nav.IsAdminAsync();
        _locked = await Lock.IsLockedAsync();
    }

    private static string InitialOf(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
}
