@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavService Nav

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/">ControClient</a>
        <nav class="app-nav">
            <a href="/clientes">Clientes</a>
            <a href="/datos">Datos</a>
            <a href="/vencimientos">Vencimientos</a>
            <a href="/buscar">Buscar</a>
            @if (_isAdmin)
            {
                <a href="/boveda">Bóveda</a>
                <a href="/usuarios">Usuarios</a>
                <a href="/grupos">Grupos</a>
                <a href="/auditoria">Auditoría</a>
                <a href="/plantillas">Tipos</a>
            }
        </nav>
        <AuthorizeView>
            <Authorized>
                <span class="user">@context.User.Identity?.Name</span>
                <a class="logout" href="/logout">Salir</a>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

@code {
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await Nav.IsAdminAsync();
    }
}
