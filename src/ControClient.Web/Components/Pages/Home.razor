@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IConfiguration Configuration

<PageTitle>Inicio</PageTitle>

<div class="page-head">
    <div>
        <h1>Gestión de clientes IT</h1>
        <p class="subtitle">Consulta y administra la información de tus clientes.</p>
    </div>
</div>

<div class="cards">
    <section class="card">
        <h2>Clientes</h2>
        <p>Alta de empresas, datos fiscales y documentación.</p>
        <a class="button primary" href="/clientes">Abrir clientes</a>
    </section>

    <section class="card">
        <h2>Datos</h2>
        <p>Fichas por cliente: equipos, servidores, redes, licencias y contactos.</p>
        <a class="button primary" href="/datos">Consultar datos</a>
    </section>

    <section class="card">
        <h2>Vencimientos</h2>
        <p>Renovaciones y garantías próximas, ordenadas por fecha.</p>
        <a class="button" href="/vencimientos">Ver vencimientos</a>
    </section>

    <section class="card">
        <h2>Búsqueda</h2>
        <p>Encuentra un cliente, una ficha o un documento por su contenido.</p>
        <a class="button" href="/buscar">Buscar</a>
    </section>
</div>

<section>
    <h2>Estado del servicio</h2>
    <p class="muted">
        Comprobación técnica en <a href="/health">/health</a>.
        Autenticación: <span class="badge">@Configuration["Authentication:Mode"]</span>
    </p>
    <p class="muted">
        Recuerda cerrar sesión con <strong>Salir</strong> si usas un equipo compartido.
    </p>
</section>


