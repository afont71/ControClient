@page "/vencimientos"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ExpirationsPageService Servicio
@inject ClientPageService Clientes
@inject FormPageService Fichas
@inject NavigationManager Nav

<PageTitle>Vencimientos</PageTitle>

<h1>Vencimientos</h1>
<p class="muted">
    Licencias, garantías, contratos y renovaciones que vencen en el horizonte elegido.
    Lo vencido aparece primero, en rojo.
</p>

<section>
    <h2>Añadir licencia</h2>
    <p class="muted">
        Las licencias y servicios son los que tienen fecha de finalización. Al guardarlos
        aparecen aquí solos, con el aviso que hayas configurado en la ficha.
    </p>
    <div class="toolbar">
        <label>Cliente
            <select @bind="_clientId">
                <option value="">Selecciona un cliente…</option>
                @foreach (var c in _clients)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </label>
        <button class="primary" @onclick="AddAsync" disabled="@(!CanAdd)">+ Añadir licencia</button>
    </div>
    @if (_templateId is null)
    {
        <p class="muted">
            No existe el tipo «Licencia». Un administrador puede crearlo en
            <a href="/plantillas">Tipos</a> con un campo de fecha.
        </p>
    }
</section>

<div class="toolbar">
    <label>Horizonte
        <select @bind="_horizon" @bind:after="LoadAsync">
            <option value="30">30 días</option>
            <option value="90">90 días</option>
            <option value="180">180 días</option>
            <option value="365">1 año</option>
        </select>
    </label>
    <button @onclick="LoadAsync" disabled="@_loading">Actualizar</button>
</div>

@if (_rows is null)
{
    <p>Sin sesión válida.</p>
}
else if (_rows.Count == 0)
{
    <p class="empty">Nada vence en ese horizonte.</p>
}
else
{
    <table>
        <thead><tr><th>Fecha</th><th>Días</th><th>Cliente</th><th>Tipo</th><th>Registro</th><th>Aviso</th></tr></thead>
        <tbody>
            @foreach (var r in _rows)
            {
                <tr class="@(r.DaysLeft < 0 ? "overdue" : r.DaysLeft <= 30 ? "soon" : "")">
                    <td>@r.Date.ToString("dd/MM/yyyy")</td>
                    <td>@(r.DaysLeft < 0 ? $"vencido hace {-r.DaysLeft}" : r.DaysLeft == 0 ? "hoy" : $"en {r.DaysLeft}")</td>
                    <td>@r.ClientName</td>
                    <td>@r.TemplateName</td>
                    <td><a href="@($"/fichas/{r.RecordId}")">@r.RecordTitle</a></td>
                    <td>
                        @if (r.DaysLeft < 0)
                        {
                            <span class="badge danger">vencido</span>
                        }
                        else if (r.DaysLeft <= r.WarningDays)
                        {
                            <span class="badge warn">avisar (@r.WarningDays d)</span>
                        }
                        else
                        {
                            <span class="muted">@r.WarningDays d</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted">@_rows.Count vencimiento(s) en @_horizon días.</p>
}

@code {
    private IReadOnlyList<ExpirationsPageService.Row>? _rows;
    private IReadOnlyList<ClientPageService.ClientRow> _clients = [];
    private Guid? _templateId;
    private string _clientId = string.Empty;
    private int _horizon = 90;
    private bool _loading;

    private bool CanAdd => _templateId is not null && Guid.TryParse(_clientId, out _);

    protected override async Task OnInitializedAsync()
    {
        var (clients, _) = await Clientes.ListAsync(null, 1, 200);
        _clients = clients;

        var templates = await Fichas.TemplatesAsync();
        _templateId = templates.FirstOrDefault(t =>
            string.Equals(t.Key, "licencia", StringComparison.OrdinalIgnoreCase))?.Id;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _rows = await Servicio.ListAsync(_horizon); }
        finally { _loading = false; }
    }

    private void AddAsync()
    {
        if (!Guid.TryParse(_clientId, out var clientId) || _templateId is null)
            return;

        Nav.NavigateTo($"/clientes/{clientId}/fichas/nueva?templateId={_templateId}");
    }
}
