@page "/usuarios"
@using Microsoft.AspNetCore.Authorization
@using ControClient.Domain.Users
@attribute [Authorize]
@inject UsersPageService Servicio

<PageTitle>Usuarios</PageTitle>

<h1>Usuarios</h1>

@if (_message is not null)
{
    <p class="@(_isError ? "error" : "ok")">@_message</p>
}

@if (_users is null)
{
    <p class="muted">Solo un administrador puede gestionar usuarios.</p>
}
else
{
    <section class="panel">
        <h2>Pre-registrar usuario</h2>
        <p class="muted">
            Crea la ficha antes de que la persona entre, para dejar preparados su rol y sus grupos.
            Al iniciar sesión, se vincula con su cuenta por el correo.
        </p>
        <p>
            <label>Correo<br /><input @bind="_newEmail" placeholder="nombre@ideonetworks.com" /></label>
            <label>Nombre<br /><input @bind="_newName" /></label>
            <label>Rol<br />
                <select @bind="_newRole">
                    @foreach (var role in Enum.GetNames<AppRole>())
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </label>
            <button @onclick="PreRegisterAsync" disabled="@_busy">Pre-registrar</button>
        </p>
    </section>
}

@if (_users is null)
{
}
else if (_users.Count == 0)
{
    <p>Sin usuarios.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Grupos</th><th>Último acceso</th><th>Activo</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var u in _users)
            {
                <tr class="@(u.IsActive ? "" : "inactive")">
                    <td>
                        @u.Name
                        @if (u.Pending)
                        {
                            <span class="badge">pendiente</span>
                        }
                    </td>
                    <td>@(u.Email ?? "—")</td>
                    <td>
                        <select value="@u.Role" @onchange="e => SetRoleAsync(u.Id, e.Value?.ToString())">
                            @foreach (var role in Enum.GetNames<AppRole>())
                            {
                                <option value="@role" selected="@(role == u.Role)">@role</option>
                            }
                        </select>
                    </td>
                    <td>@(string.IsNullOrEmpty(u.Groups) ? "—" : u.Groups)</td>
                    <td>@(u.LastLogin?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    <td>
                        <input type="checkbox" checked="@u.IsActive" @onchange="e => SetActiveAsync(u.Id, e.Value is bool b && b)" />
                    </td>
                    <td>
                        @if (u.Pending)
                        {
                            <button @onclick="() => DeletePendingAsync(u.Id)">Eliminar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="muted">El rol global concede capacidades; el acceso a cada cliente se da con concesiones directas o a través de grupos. Un administrador nunca revela secretos.</p>

@code {
    private IReadOnlyList<UsersPageService.UserRow>? _users;
    private string? _message;
    private bool _isError;
    private string? _newEmail;
    private string? _newName;
    private string _newRole = nameof(AppRole.ReadOnly);
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _users = await Servicio.ListAsync();

    private async Task PreRegisterAsync()
    {
        _busy = true;
        try
        {
            var (id, error) = await Servicio.PreRegisterAsync(_newEmail ?? string.Empty, _newName, _newRole);
            if (id is null)
            {
                SetMessage(error ?? "No se pudo pre-registrar.", true);
                return;
            }

            SetMessage("Usuario pre-registrado. Entrará con ese correo y conservará rol y grupos.", false);
            _newEmail = _newName = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetRoleAsync(Guid userId, string? role)
    {
        if (string.IsNullOrWhiteSpace(role)) return;
        var (ok, error) = await Servicio.SetRoleAsync(userId, role);
        SetMessage(ok ? "Rol actualizado." : error ?? "No se pudo cambiar.", !ok);
        await LoadAsync();
    }

    private async Task SetActiveAsync(Guid userId, bool active)
    {
        var (ok, error) = await Servicio.SetActiveAsync(userId, active);
        SetMessage(ok ? (active ? "Usuario activado." : "Usuario desactivado.") : error ?? "No se pudo cambiar.", !ok);
        await LoadAsync();
    }

    private async Task DeletePendingAsync(Guid userId)
    {
        var (ok, error) = await Servicio.DeletePendingAsync(userId);
        SetMessage(ok ? "Ficha pendiente eliminada." : error ?? "No se pudo eliminar.", !ok);
        await LoadAsync();
    }

    private void SetMessage(string text, bool error)
    {
        _message = text;
        _isError = error;
    }
}
