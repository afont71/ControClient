@page "/usuarios"
@using Microsoft.AspNetCore.Authorization
@using ControClient.Domain.Users
@attribute [Authorize]
@inject UsersPageService Servicio

<PageTitle>Usuarios</PageTitle>

<h1>Usuarios</h1>

@if (_message is not null)
{
    <p class="@(_isError ? "error" : "ok")">@_message</p>
}

@if (_users is null)
{
    <p class="muted">Solo un administrador puede gestionar usuarios.</p>
}
else
{
    <section class="panel">
        <h2>Pre-registrar usuario</h2>
        <p class="muted">
            Crea la ficha antes de que la persona entre, para dejar preparados su rol y sus grupos.
            Al iniciar sesión, se vincula con su cuenta por el correo.
        </p>
        <p>
            <label>Correo<br /><input @bind="_newEmail" placeholder="nombre@ideonetworks.com" /></label>
            <label>Nombre<br /><input @bind="_newName" /></label>
            <label>Perfil<br />
                <select @bind="_newRole">
                    @foreach (var role in Ui.AssignableRoles)
                    {
                        <option value="@role">@Ui.RoleLabel(role)</option>
                    }
                </select>
            </label>
            </p>
        <p>
            <strong>Grupos</strong> <span class="muted">(los permisos de sus clientes se heredan al entrar)</span>
        </p>

        <div class="chips">
            @if (_selectedGroups.Count == 0)
            {
                <span class="muted small">Sin grupos asignados.</span>
            }
            else
            {
                @foreach (var groupId in _selectedGroups)
                {
                    var groupName = _groups.FirstOrDefault(g => g.Id == groupId).Name ?? "grupo";
                    <span class="chip">
                        @groupName
                        <button class="chip-remove" title="Quitar" @onclick="() => RemoveGroup(groupId)">×</button>
                    </span>
                }
            }
        </div>

        @if (_groups.Count == 0)
        {
            <p class="muted small">No hay grupos creados todavía.</p>
        }
        else
        {
            <div class="toolbar">
                <label>Añadir grupo
                    <select @bind="_groupToAdd">
                        <option value="">Selecciona…</option>
                        @foreach (var g in _groups.Where(g => !_selectedGroups.Contains(g.Id)))
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                </label>
                <button @onclick="AddGroupAsync" disabled="@string.IsNullOrEmpty(_groupToAdd)">Añadir</button>
            </div>
        }

        <p>
            <button @onclick="PreRegisterAsync" disabled="@_busy">Pre-registrar</button>
        </p>
    </section>
}

@if (_users is null)
{
}
else if (_users.Count == 0)
{
    <p>Sin usuarios.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Grupos</th><th>Marcar secretos</th><th>Último acceso</th><th>Activo</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var u in _users)
            {
                <tr class="@(u.IsActive ? "" : "inactive")">
                    <td>
                        @u.Name
                        @if (u.Pending)
                        {
                            <span class="badge">pendiente</span>
                        }
                    </td>
                    <td>@(u.Email ?? "—")</td>
                    <td>
                        <select value="@u.Role" @onchange="e => SetRoleAsync(u.Id, e.Value?.ToString())">
                            @foreach (var role in Ui.AssignableRoles)
                            {
                                <option value="@role" selected="@(role == u.Role)">@Ui.RoleLabel(role)</option>
                            }
                        </select>
                    </td>
                    <td>@(string.IsNullOrEmpty(u.Groups) ? "—" : u.Groups)</td>
                    <td>
                        <input type="checkbox" checked="@u.CanMarkSecrets"
                               disabled="@(u.Role == "Administrator")"
                               title="@(u.Role == "Administrator" ? "El administrador siempre puede" : "Permitir marcar o desmarcar secretos")"
                               @onchange="e => SetMarkSecretsAsync(u.Id, e.Value is bool b && b)" />
                    </td>
                    <td>@(u.LastLogin?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    <td>
                        <input type="checkbox" checked="@u.IsActive" @onchange="e => SetActiveAsync(u.Id, e.Value is bool b && b)" />
                    </td>
                    <td>
                        @if (u.Pending)
                        {
                            <button @onclick="() => DeletePendingAsync(u.Id)">Eliminar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="muted">El rol global concede capacidades; el acceso a cada cliente se da con concesiones directas o a través de grupos. Un administrador nunca revela secretos.</p>

@code {
    private IReadOnlyList<UsersPageService.UserRow>? _users;
    private string? _message;
    private bool _isError;
    private string? _newEmail;
    private string? _newName;
    private string _newRole = nameof(AppRole.ReadOnly);
    private bool _busy;
    private IReadOnlyList<(Guid Id, string Name)> _groups = [];
    private readonly HashSet<Guid> _selectedGroups = [];
    private string _groupToAdd = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _groups = await Servicio.GroupsAsync();
        await LoadAsync();
    }

    private void AddGroupAsync()
    {
        if (Guid.TryParse(_groupToAdd, out var groupId))
            _selectedGroups.Add(groupId);

        _groupToAdd = string.Empty;
    }

    private void RemoveGroup(Guid groupId) => _selectedGroups.Remove(groupId);

    private async Task LoadAsync() => _users = await Servicio.ListAsync();

    private async Task PreRegisterAsync()
    {
        _busy = true;
        try
        {
            var (id, error) = await Servicio.PreRegisterAsync(_newEmail ?? string.Empty, _newName, _newRole, _selectedGroups.ToList());
            if (id is null)
            {
                SetMessage(error ?? "No se pudo pre-registrar.", true);
                return;
            }

            SetMessage("Usuario pre-registrado. Entrará con ese correo y conservará rol y grupos.", false);
            _newEmail = _newName = null;
            _selectedGroups.Clear();
            _groupToAdd = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetRoleAsync(Guid userId, string? role)
    {
        if (string.IsNullOrWhiteSpace(role)) return;
        var (ok, error) = await Servicio.SetRoleAsync(userId, role);
        SetMessage(ok ? "Rol actualizado." : error ?? "No se pudo cambiar.", !ok);
        await LoadAsync();
    }

    private async Task SetMarkSecretsAsync(Guid userId, bool allowed)
    {
        var (ok, error) = await Servicio.SetCanMarkSecretsAsync(userId, allowed);
        SetMessage(ok ? "Permiso de secretos actualizado." : error ?? "No se pudo cambiar.", !ok);
        await LoadAsync();
    }

    private async Task SetActiveAsync(Guid userId, bool active)
    {
        var (ok, error) = await Servicio.SetActiveAsync(userId, active);
        SetMessage(ok ? (active ? "Usuario activado." : "Usuario desactivado.") : error ?? "No se pudo cambiar.", !ok);
        await LoadAsync();
    }

    private async Task DeletePendingAsync(Guid userId)
    {
        var (ok, error) = await Servicio.DeletePendingAsync(userId);
        SetMessage(ok ? "Ficha pendiente eliminada." : error ?? "No se pudo eliminar.", !ok);
        await LoadAsync();
    }

    private void SetMessage(string text, bool error)
    {
        _message = text;
        _isError = error;
    }
}
