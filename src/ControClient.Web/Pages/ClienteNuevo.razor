@page "/clientes/nuevo"
@using Microsoft.AspNetCore.Authorization
@using ControClient.Domain.Clients
@attribute [Authorize]
@inject ClientPageService Clientes
@inject NavigationManager Navigation

<PageTitle>Nuevo cliente</PageTitle>

<div class="form-panel">
    <header class="page-head">
        <div>
            <h1>Nuevo cliente</h1>
            <p class="subtitle">Datos de la empresa, dirección y persona de contacto.</p>
        </div>
    </header>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <h3>Datos de la empresa</h3>
        <div class="form-grid">
            <label>
                Nombre *
                <InputText @bind-Value="_model.Name" />
                <ValidationMessage For="() => _model.Name" />
            </label>
            <label>Alias<InputText @bind-Value="_model.Alias" /></label>
            <label>CIF / NIF<InputText @bind-Value="_model.TaxId" /></label>
            <label>Sitio web<InputText @bind-Value="_model.Website" placeholder="https://" /></label>
        </div>

        <h3>Dirección</h3>
        <div class="form-grid">
            <label class="wide-2">Dirección<InputText @bind-Value="_model.Address" placeholder="Calle y número" /></label>
            <label>Código postal<InputText @bind-Value="_model.PostalCode" /></label>
            <label>Ciudad<InputText @bind-Value="_model.City" /></label>
            <label>Provincia<InputText @bind-Value="_model.Province" /></label>
            <label>País<InputText @bind-Value="_model.Country" placeholder="España" /></label>
        </div>

        <h3>Persona de contacto</h3>
        <div class="form-grid">
            <label>Nombre<InputText @bind-Value="_model.ContactName" /></label>
            <label>Cargo<InputText @bind-Value="_model.ContactRole" placeholder="Gerente, administración…" /></label>
            <label>Correo<InputText @bind-Value="_model.ContactEmail" InputMode="InputMode.email" /></label>
            <label>Teléfono<InputText @bind-Value="_model.ContactPhone" InputMode="InputMode.tel" /></label>
            <label>Móvil<InputText @bind-Value="_model.ContactMobile" InputMode="InputMode.tel" /></label>
        </div>

        <div class="form-grid">
            <label class="wide">Notas<InputTextArea @bind-Value="_model.Notes" rows="4" /></label>
        </div>

        <div class="form-actions">
            <button class="primary" type="submit" disabled="@_saving">@(_saving ? "Guardando…" : "Crear cliente")</button>
            <a class="button" href="/clientes">Cancelar</a>
        </div>
    </EditForm>

    <p class="muted small">El estado comercial empieza como «Pendiente de validar»: no se deduce de la actividad documental.</p>
</div>

@code {
    private readonly Model _model = new();
    private string? _error;
    private bool _saving;

    public sealed class Model
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        [System.ComponentModel.DataAnnotations.StringLength(200)]
        public string Name { get; set; } = string.Empty;

        public string? Alias { get; set; }
        public string? TaxId { get; set; }
        public string? Address { get; set; }
        public string? PostalCode { get; set; }
        public string? City { get; set; }
        public string? Province { get; set; }
        public string? Country { get; set; }
        public string? ContactName { get; set; }
        public string? ContactRole { get; set; }
        public string? ContactEmail { get; set; }
        public string? ContactPhone { get; set; }
        public string? ContactMobile { get; set; }
        public string? Website { get; set; }
        public string? Notes { get; set; }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var details = new ClientDetails(
                _model.Alias, _model.TaxId, _model.Address, _model.PostalCode, _model.City,
                _model.Province, _model.Country, _model.ContactName, _model.ContactRole,
                _model.ContactEmail, _model.ContactPhone, _model.ContactMobile, _model.Website, _model.Notes);

            var (ok, error) = await Clientes.CreateAsync(_model.Name, details);
            if (!ok)
            {
                _error = error;
                return;
            }

            Navigation.NavigateTo("/clientes");
        }
        finally
        {
            _saving = false;
        }
    }
}
