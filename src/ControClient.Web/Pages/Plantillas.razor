@page "/plantillas"
@using Microsoft.AspNetCore.Authorization
@using ControClient.Domain.Forms
@attribute [Authorize]
@inject TemplatesPageService Servicio

<PageTitle>Tipos de ficha</PageTitle>

<h1>Tipos de ficha</h1>

<p class="muted">
    Un tipo de ficha es una plantilla con sus campos. Por ejemplo: <em>Impresora</em> con
    <em>nombre</em>, <em>modelo</em>, <em>IP</em> y <em>fecha de compra</em>.
    AquÃ­ se define quÃ© se puede rellenar despuÃ©s en cada cliente.
</p>

@if (_message is not null)
{
    <p class="@(_isError ? "error" : "ok")">@_message</p>
}

@if (_templates is null)
{
    <p class="muted">Solo un administrador puede gestionar tipos de ficha.</p>
}
else
{
    <section class="panel">
        <h2>@(_editingId is null ? "Nuevo tipo" : $"Editar Â«{_name}Â»")</h2>

        @if (_editingId is not null)
        {
            <p class="muted">
                Guardar crea una versiÃ³n nueva del tipo. Las fichas ya rellenadas conservan
                la versiÃ³n con la que se crearon.
            </p>
        }

        <p>
            <label>Nombre<br /><input @bind="_name" placeholder="Impresora" /></label>
            <label>DescripciÃ³n<br /><input @bind="_description" placeholder="Para quÃ© sirve este tipo" /></label>
            <label>Clave interna<br /><input @bind="_key" placeholder="impresora" disabled="@(_editingId is not null)" /></label>
        </p>
        <p class="muted">
            La clave es un identificador interno sin espacios ni acentos (por ejemplo
            <code>impresora</code>). No se muestra al usuario y no se puede cambiar despuÃ©s.
        </p>

        <h3>Campos</h3>
        <table>
            <thead>
                <tr><th>Etiqueta (lo que se ve)</th><th>Clave interna</th><th>Tipo</th><th>Obligatorio</th><th>Secreto</th><th>Valores de la lista</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var f in _fields)
                {
                    <tr>
                        <td><input @bind="f.Label" placeholder="Modelo" /></td>
                        <td><input @bind="f.Key" placeholder="modelo" disabled="@(_editingId is not null && f.Locked)" /></td>
                        <td>
                            <select @bind="f.Type">
                                @foreach (var type in Enum.GetNames<FieldType>())
                                {
                                    <option value="@type">@Describe(type)</option>
                                }
                            </select>
                        </td>
                        <td><input type="checkbox" @bind="f.Required" /></td>
                        <td><input type="checkbox" @bind="f.IsSecret" title="Se guarda cifrado y solo se revela con permiso" /></td>
                        <td>
                            @if (f.Type is nameof(FieldType.Select) or nameof(FieldType.MultiSelect))
                            {
                                <input @bind="f.OptionsCsv" placeholder="SÃ­, No, No aplica" />
                            }
                            else
                            {
                                <span class="muted">â€”</span>
                            }
                        </td>
                        <td><button @onclick="() => RemoveField(f)">Quitar</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="muted">
            Â«Valores de la listaÂ» solo se usa en los tipos Lista y Lista mÃºltiple: escribe las
            opciones separadas por comas, por ejemplo <code>SÃ­, No, No aplica</code>.
        </p>

        <p>
            <button @onclick="AddField">+ AÃ±adir campo</button>
            <button @onclick="SaveAsync" disabled="@_busy">@(_editingId is null ? "Crear tipo" : "Guardar nueva versiÃ³n")</button>
            @if (_editingId is not null)
            {
                <button @onclick="CancelEdit">Cancelar</button>
            }
        </p>
    </section>

    <section>
        <h2>Tipos existentes</h2>
        <table>
            <thead><tr><th>Nombre</th><th>DescripciÃ³n</th><th>Clave</th><th>VersiÃ³n</th><th>Campos</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in _templates)
                {
                    <tr>
                        <td>@t.Name</td>
                        <td>@(t.Description ?? "â€”")</td>
                        <td><code>@t.Key</code></td>
                        <td>@t.Version</td>
                        <td>@t.Fields</td>
                        <td><button @onclick="() => EditAsync(t)">Editar</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private IReadOnlyList<TemplatesPageService.TemplateRow>? _templates;
    private readonly List<Draft> _fields = [new Draft()];
    private string? _key;
    private string? _name;
    private string? _description;
    private Guid? _editingId;
    private string? _message;
    private bool _isError;
    private bool _busy;

    public sealed class Draft
    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Type { get; set; } = nameof(FieldType.Text);
        public bool Required { get; set; }
        public string? OptionsCsv { get; set; }
        public bool IsSecret { get; set; }
        public bool Locked { get; set; }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _templates = await Servicio.ListAsync();

    private void AddField() => _fields.Add(new Draft());

    private void RemoveField(Draft draft) => _fields.Remove(draft);

    private async Task EditAsync(TemplatesPageService.TemplateRow template)
    {
        _editingId = template.Id;
        _key = template.Key;
        _name = template.Name;
        _description = template.Description;

        var existing = await Servicio.FieldsAsync(template.Id);
        _fields.Clear();
        foreach (var f in existing)
        {
            _fields.Add(new Draft
            {
                Key = f.Key,
                Label = f.Label,
                Type = f.Type,
                Required = f.Required,
                OptionsCsv = f.OptionsCsv,
                IsSecret = f.IsSecret,
                Locked = true
            });
        }

        if (_fields.Count == 0)
            _fields.Add(new Draft());
    }

    private void CancelEdit()
    {
        _editingId = null;
        _key = _name = _description = null;
        _fields.Clear();
        _fields.Add(new Draft());
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var drafts = _fields
                .Where(f => !string.IsNullOrWhiteSpace(f.Key) || !string.IsNullOrWhiteSpace(f.Label))
                .Select(f => new TemplatesPageService.FieldDraft(f.Key, f.Label, f.Type, f.Required, f.OptionsCsv, f.IsSecret))
                .ToList();

            var (id, error) = _editingId is Guid editing
                ? await Servicio.UpdateAsync(editing, _name ?? string.Empty, _description, drafts)
                : await Servicio.CreateAsync(_key ?? string.Empty, _name ?? string.Empty, _description, drafts);

            if (id is null)
            {
                SetMessage(error ?? "No se pudo guardar.", true);
                return;
            }

            SetMessage(_editingId is null
                ? "Tipo creado. Ya aparece al aÃ±adir informaciÃ³n a un cliente."
                : "Nueva versiÃ³n guardada. Se usarÃ¡ en las prÃ³ximas fichas.", false);

            CancelEdit();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Describe(string type) => type switch
    {
        nameof(FieldType.Text) => "Texto",
        nameof(FieldType.LongText) => "Texto largo",
        nameof(FieldType.Number) => "NÃºmero",
        nameof(FieldType.Date) => "Fecha",
        nameof(FieldType.Boolean) => "SÃ­/No",
        nameof(FieldType.Select) => "Lista",
        nameof(FieldType.MultiSelect) => "Lista mÃºltiple",
        nameof(FieldType.Email) => "Correo",
        nameof(FieldType.Url) => "Enlace",
        nameof(FieldType.Ip) => "DirecciÃ³n IP",
        _ => type
    };

    private void SetMessage(string text, bool error)
    {
        _message = text;
        _isError = error;
    }
}
