@page "/clientes/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using ControClient.Domain.Clients
@using ControClient.Domain.Documents
@using ControClient.Domain.Vault
@attribute [Authorize]
@inject ClientPageService Clientes
@inject FormPageService Fichas
@inject DocumentPageService Documentos
@inject VaultPageService Boveda

<PageTitle>Ficha de cliente</PageTitle>

@if (_loading)
{
    <p>Cargando…</p>
}
else if (_client is null)
{
    <h1>Cliente no disponible</h1>
    <p class="muted">No existe o no tienes acceso a él.</p>
    <a href="/clientes">Volver</a>
}
else
{
    <h1>@_client.Name</h1>
    <p><a class="button" href="@($"/datos/{Id}")">Ver y editar información del cliente</a> <a href="/clientes">Volver a clientes</a></p>
    <p class="muted">
        Alias: @(_client.Alias ?? "—") · Estado: <span class="badge @Ui.StatusBadge(_client.Status)">@Ui.StatusLabel(_client.Status)</span> ·
        Creado: @_client.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
    </p>

    @if (_message is not null)
    {
        <p class="@(_isError ? "error" : "ok")">@_message</p>
    }

    @if (_client.CanEdit)
    {
        <section>
            <h2>Datos de la empresa</h2>
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <h3>Datos de la empresa</h3>
                <div class="form-grid">
                    <label>Nombre *<InputText @bind-Value="_form.Name" /><ValidationMessage For="() => _form.Name" /></label>
                    <label>Alias<InputText @bind-Value="_form.Alias" /></label>
                    <label>CIF / NIF<InputText @bind-Value="_form.TaxId" /></label>
                    <label>Sitio web<InputText @bind-Value="_form.Website" placeholder="https://" /></label>
                    <label>Estado comercial
                        <InputSelect @bind-Value="_form.Status">
                            @foreach (var status in Enum.GetNames<ClientStatus>())
                            {
                                <option value="@status">@Ui.StatusLabel(status)</option>
                            }
                        </InputSelect>
                    </label>
                </div>

                <h3>Dirección</h3>
                <div class="form-grid">
                    <label class="wide-2">Dirección<InputText @bind-Value="_form.Address" placeholder="Calle y número" /></label>
                    <label>Código postal<InputText @bind-Value="_form.PostalCode" /></label>
                    <label>Ciudad<InputText @bind-Value="_form.City" /></label>
                    <label>Provincia<InputText @bind-Value="_form.Province" /></label>
                    <label>País<InputText @bind-Value="_form.Country" placeholder="España" /></label>
                </div>

                <h3>Persona de contacto</h3>
                <div class="form-grid">
                    <label>Nombre<InputText @bind-Value="_form.ContactName" /></label>
                    <label>Cargo<InputText @bind-Value="_form.ContactRole" /></label>
                    <label>Correo<InputText @bind-Value="_form.ContactEmail" InputMode="InputMode.email" /></label>
                    <label>Teléfono<InputText @bind-Value="_form.ContactPhone" InputMode="InputMode.tel" /></label>
                    <label>Móvil<InputText @bind-Value="_form.ContactMobile" InputMode="InputMode.tel" /></label>
                </div>

                <div class="form-grid">
                    <label class="wide">Notas<InputTextArea @bind-Value="_form.Notes" rows="4" /></label>
                </div>
                <button type="submit" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar")</button>
            </EditForm>
        </section>

    }
    else
    {
        <p class="muted">Tienes acceso de consulta: no puedes modificar este cliente.</p>
    }


    <section>
        <h2>Documentación</h2>

        @if (_documents.Count == 0)
        {
            <p>Sin documentos.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Documento</th><th>Clasificación</th><th>Versión</th><th>Tamaño</th><th>Actualizado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in _documents)
                    {
                        <tr>
                            <td>@d.Name</td>
                            <td>@d.Classification</td>
                            <td>@d.CurrentVersion</td>
                            <td>@FormatSize(d.SizeBytes)</td>
                            <td>@d.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="row-actions">
                                    <a href="@($"/api/v1/documents/{d.Id}/content?inline=true")" target="_blank" rel="noopener">Ver</a>
                                    <a href="@($"/api/v1/documents/{d.Id}/content")">Descargar</a>
                                    @if (_client.CanEdit)
                                    {
                                        <button class="small" @onclick="() => StartVersion(d.Id, d.Name)">Nueva versión</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_client.CanEdit)
        {
            <h3>@(_targetDocumentId is null ? "Subir documento" : $"Nueva versión de {_targetName}")</h3>

            @if (_uploadMessage is not null)
            {
                <p class="@(_uploadIsError ? "error" : "ok")">@_uploadMessage</p>
            }

            @if (_targetDocumentId is null)
            {
                <p><label>Nombre del documento<br /><input @bind="_docName" placeholder="Ej. Contrato mantenimiento" /></label></p>
                <p>
                    <label>Clasificación<br />
                        <select @bind="_classification">
                            @foreach (var value in Enum.GetNames<DocumentClassification>())
                            {
                                <option value="@value">@value</option>
                            }
                        </select>
                    </label>
                </p>
            }

            <p><InputFile OnChange="OnFileSelected" /></p>
            @if (_file is not null)
            {
                <p class="muted">@_file.Name · @FormatSize(_file.Size)</p>
            }

            <button @onclick="UploadAsync" disabled="@(_file is null || _uploading)">
                @(_uploading ? "Subiendo…" : "Subir")
            </button>
            @if (_targetDocumentId is not null)
            {
                <button @onclick="CancelVersion">Cancelar</button>
            }
        }
    </section>


    <p><a href="/clientes">Volver a clientes</a></p>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ClientPageService.ClientDetail? _client;
    private IReadOnlyList<ClientPageService.GrantRow> _grants = [];
    private IReadOnlyList<ClientPageService.UserRow> _users = [];
    private IReadOnlyList<FormPageService.RecordRow> _records = [];
    private IReadOnlyList<FormPageService.TemplateRow> _templates = [];
    private IReadOnlyList<DocumentPageService.DocumentRow> _documents = [];
    private IReadOnlyList<VaultPageService.ItemRow> _vaultItems = [];
    private readonly Dictionary<Guid, string> _revealed = [];
    private bool _canReveal;
    private string? _vaultName;
    private string _vaultKind = nameof(VaultItemKind.Password);
    private string? _vaultUser;
    private string? _vaultUrl;
    private string? _vaultNotes;
    private string? _vaultSecret;
    private string? _vaultMessage;
    private bool _vaultIsError;
    private bool _vaultSaving;
    private IBrowserFile? _file;
    private string? _docName;
    private DocumentClassification _classification = DocumentClassification.Internal;
    private Guid? _targetDocumentId;
    private string? _targetName;
    private string? _uploadMessage;
    private bool _uploadIsError;
    private bool _uploading;
    private readonly Form _form = new();
    private readonly GrantForm _grantForm = new();
    private bool _loading = true;
    private bool _saving;
    private string? _message;
    private bool _isError;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _client = await Clientes.GetAsync(Id);
        if (_client is not null)
        {
            _form.Name = _client.Name;
            _form.Status = _client.Status;
            _form.Alias = _client.Alias;
            _form.TaxId = _client.TaxId;
            _form.Address = _client.Address;
            _form.PostalCode = _client.PostalCode;
            _form.City = _client.City;
            _form.Province = _client.Province;
            _form.Country = _client.Country;
            _form.ContactName = _client.ContactName;
            _form.ContactRole = _client.ContactRole;
            _form.ContactEmail = _client.ContactEmail;
            _form.ContactPhone = _client.ContactPhone;
            _form.ContactMobile = _client.ContactMobile;
            _form.Website = _client.Website;
            _form.Notes = _client.Notes;
            _grants = await Clientes.GrantsAsync(Id);
            _users = await Clientes.UsersAsync();
            _records = await Fichas.RecordsAsync(Id);
            _templates = await Fichas.TemplatesAsync();
            _documents = await Documentos.ListAsync(Id);
            var vault = await Boveda.ListAsync(Id);
            _vaultItems = vault.Items;
            _canReveal = vault.CanReveal;
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            var details = new ClientDetails(
                _form.Alias, _form.TaxId, _form.Address, _form.PostalCode, _form.City,
                _form.Province, _form.Country, _form.ContactName, _form.ContactRole,
                _form.ContactEmail, _form.ContactPhone, _form.ContactMobile, _form.Website, _form.Notes);

            var (ok, error) = await Clientes.UpdateAsync(Id, _form.Name, _form.Status, details);
            SetMessage(ok ? "Cliente actualizado." : error ?? "No se pudo guardar.", !ok);
            if (ok) await OnParametersSetAsync();
        }
        finally { _saving = false; }
    }

    private async Task GrantAsync()
    {
        if (!Guid.TryParse(_grantForm.UserId, out var userId))
        {
            SetMessage("Selecciona un usuario.", true);
            return;
        }

        var actions = GrantActions.None;
        if (_grantForm.View) actions |= GrantActions.View;
        if (_grantForm.Edit) actions |= GrantActions.Edit;
        if (_grantForm.Reveal) actions |= GrantActions.RevealSecret;

        _saving = true;
        try
        {
            var (ok, error) = await Clientes.UpsertGrantAsync(Id, userId, actions, null);
            SetMessage(ok ? "Concesión guardada." : error ?? "No se pudo guardar.", !ok);
            if (ok) await OnParametersSetAsync();
        }
        finally { _saving = false; }
    }

    private async Task RevokeAsync(Guid grantId)
    {
        var (ok, error) = await Clientes.RevokeAsync(Id, grantId);
        SetMessage(ok ? "Concesión revocada." : error ?? "No se pudo revocar.", !ok);
        if (ok) await OnParametersSetAsync();
    }

    private void SetMessage(string text, bool error)
    {
        _message = text;
        _isError = error;
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _file = args.File;
        _uploadMessage = null;
    }

    private void StartVersion(Guid documentId, string name)
    {
        _targetDocumentId = documentId;
        _targetName = name;
        _docName = null;
        _file = null;
        _uploadMessage = null;
    }

    private void CancelVersion()
    {
        _targetDocumentId = null;
        _targetName = null;
        _file = null;
        _uploadMessage = null;
    }

    private async Task UploadAsync()
    {
        if (_file is null)
        {
            SetUpload("Selecciona un fichero.", true);
            return;
        }

        _uploading = true;
        try
        {
            const long max = 50L * 1024 * 1024;
            await using var stream = _file.OpenReadStream(max);

            var (ok, error) = _targetDocumentId is Guid target
                ? await Documentos.NewVersionAsync(target, _file.Name, stream)
                : await Documentos.UploadAsync(Id, _docName, _classification, _file.Name, stream);

            if (!ok)
            {
                SetUpload(error ?? "No se pudo subir el documento.", true);
                return;
            }

            SetUpload(_targetDocumentId is null ? "Documento subido." : "Nueva versión añadida.", false);
            _file = null;
            _docName = null;
            _targetDocumentId = null;
            _targetName = null;
            _documents = await Documentos.ListAsync(Id);
        }
        catch (Exception ex)
        {
            SetUpload($"Error al subir: {ex.Message}", true);
        }
        finally
        {
            _uploading = false;
        }
    }

    private void SetUpload(string text, bool error)
    {
        _uploadMessage = text;
        _uploadIsError = error;
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.0} MB",
        >= 1024 => $"{bytes / 1024.0:0} KB",
        _ => $"{bytes} B"
    };

    private async Task RevealAsync(Guid itemId)
    {
        var (secret, error) = await Boveda.RevealAsync(itemId);
        if (secret is null)
        {
            SetVault(error ?? "No se pudo revelar.", true);
            return;
        }

        _revealed[itemId] = secret;
        _vaultMessage = null;
    }

    private void Hide(Guid itemId) => _revealed.Remove(itemId);

    private async Task CreateVaultItemAsync()
    {
        if (string.IsNullOrWhiteSpace(_vaultName) || string.IsNullOrWhiteSpace(_vaultSecret))
        {
            SetVault("Nombre y secreto son obligatorios.", true);
            return;
        }

        _vaultSaving = true;
        try
        {
            var (ok, error) = await Boveda.CreateAsync(Id, _vaultName!, _vaultKind, _vaultUser, _vaultUrl, _vaultNotes, _vaultSecret!);
            if (!ok)
            {
                SetVault(error ?? "No se pudo guardar.", true);
                return;
            }

            SetVault("Credencial guardada.", false);
            _vaultName = _vaultUser = _vaultUrl = _vaultNotes = _vaultSecret = null;
            var vault = await Boveda.ListAsync(Id);
            _vaultItems = vault.Items;
            _canReveal = vault.CanReveal;
        }
        finally
        {
            _vaultSaving = false;
        }
    }

    private void SetVault(string text, bool error)
    {
        _vaultMessage = text;
        _vaultIsError = error;
    }

    public sealed class Form
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = nameof(ClientStatus.PendingValidation);
        public string? Alias { get; set; }
        public string? TaxId { get; set; }
        public string? Address { get; set; }
        public string? PostalCode { get; set; }
        public string? City { get; set; }
        public string? Province { get; set; }
        public string? Country { get; set; }
        public string? ContactName { get; set; }
        public string? ContactRole { get; set; }
        public string? ContactEmail { get; set; }
        public string? ContactPhone { get; set; }
        public string? ContactMobile { get; set; }
        public string? Website { get; set; }
        public string? Notes { get; set; }
    }

    public sealed class GrantForm
    {
        public string UserId { get; set; } = string.Empty;
        public bool View { get; set; } = true;
        public bool Edit { get; set; }
        public bool Reveal { get; set; }
    }
}
