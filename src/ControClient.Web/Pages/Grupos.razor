@page "/grupos"
@using Microsoft.AspNetCore.Authorization
@using ControClient.Domain.Clients
@attribute [Authorize]
@inject GroupsPageService Servicio

<PageTitle>Grupos</PageTitle>

<h1>Grupos</h1>
<p class="muted">
    Un grupo reúne personas y les da acceso a clientes. Marca en cada cliente qué puede
    hacer el grupo; el «+» abre sus datos para dar permisos a una ficha concreta.
</p>

@if (_message is not null)
{
    <p class="@(_isError ? "error" : "ok")">@_message</p>
}

@if (_groups is null)
{
    <p class="muted">Solo un administrador puede gestionar grupos.</p>
}
else
{
    <section>
        <h2>Nuevo grupo</h2>
        <div class="toolbar">
            <label>Nombre<input @bind="_newName" placeholder="Soporte" /></label>
            <label>Descripción<input @bind="_newDescription" placeholder="Equipo de soporte" /></label>
            <button class="primary" @onclick="CreateAsync" disabled="@_busy">Crear grupo</button>
        </div>
    </section>

    <section>
        <h2>Grupos</h2>
        <table>
            <thead><tr><th>Nombre</th><th>Descripción</th><th>Miembros</th><th>Clientes</th><th></th></tr></thead>
            <tbody>
                @foreach (var g in _groups)
                {
                    <tr class="@(g.Id == _selectedId ? "selected" : "")">
                        <td>@g.Name @if (g.IsSystem) { <span class="badge">sistema</span> }</td>
                        <td>@(g.Description ?? "—")</td>
                        <td>@g.Members</td>
                        <td>@g.Clients</td>
                        <td>
                            @if (g.IsSystem)
                            {
                                <span class="muted small">acceso total · no editable</span>
                            }
                            else
                            {
                                <button class="small" @onclick="() => SelectAsync(g.Id)">Gestionar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    @if (_detail is not null)
    {
        <section>
            <h2>@_detail.Name · miembros</h2>
            @if (_detail.Members.Count == 0)
            {
                <p class="muted">Sin miembros.</p>
            }
            else
            {
                <table>
                    <thead><tr><th>Nombre</th><th>Correo</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in _detail.Members)
                        {
                            <tr>
                                <td>@m.Name</td>
                                <td>@(m.Email ?? "—")</td>
                                <td><button class="small danger" @onclick="() => RemoveMemberAsync(m.UserId)">Quitar</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="toolbar">
                <label>Nuevo miembro
                    <select @bind="_memberToAdd">
                        <option value="">Selecciona…</option>
                        @foreach (var u in _users)
                        {
                            <option value="@u.Id">@u.Name</option>
                        }
                    </select>
                </label>
                <button @onclick="AddMemberAsync" disabled="@_busy">Añadir miembro</button>
            </div>
        </section>

        <section>
            <h2>Clientes y permisos</h2>
            <p class="muted">
                Ver = consultar el cliente · Editar = modificar sus datos · Revelar = ver credenciales.
                La fila del cliente es el permiso general. El «+» abre sus fichas: allí los checks
                mandan sobre el cliente, así que puedes quitar el ver a una ficha concreta. «Heredar»
                elimina esa excepción y vuelve a los permisos del cliente.
            </p>

            @if (_matrix.Count == 0)
            {
                <p>No hay clientes.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr><th>Cliente</th><th>Ver</th><th>Editar</th><th>Revelar</th><th>Datos</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _matrix)
                        {
                            var canView = (row.Actions & (int)GrantActions.View) != 0;
                            var canEdit = (row.Actions & (int)GrantActions.Edit) != 0;
                            var canReveal = (row.Actions & (int)GrantActions.RevealSecret) != 0;
                            var open = _openClients.Contains(row.ClientId);

                            <tr>
                                <td>@row.ClientName</td>
                                <td><input type="checkbox" checked="@canView" @onchange="e => SetClientAsync(row, GrantActions.View, e)" /></td>
                                <td><input type="checkbox" checked="@canEdit" @onchange="e => SetClientAsync(row, GrantActions.Edit, e)" /></td>
                                <td><input type="checkbox" checked="@canReveal" @onchange="e => SetClientAsync(row, GrantActions.RevealSecret, e)" /></td>
                                <td>
                                    <button class="small" @onclick="() => ToggleRecordsAsync(row)">
                                        @(open ? "−" : "+")
                                    </button>
                                </td>
                            </tr>

                            @if (open)
                            {
                                <tr>
                                    <td colspan="5" class="records-cell">
                                        @if (!_recordsByClient.TryGetValue(row.ClientId, out var records))
                                        {
                                            <span class="muted">Cargando…</span>
                                        }
                                        else if (records.Count == 0)
                                        {
                                            <span class="muted">Este cliente no tiene fichas.</span>
                                        }
                                        else
                                        {
                                            <table class="inner">
                                                <thead><tr><th>Ficha</th><th>Tipo</th><th>Ver</th><th>Editar</th><th>Revelar</th><th></th></tr></thead>
                                                <tbody>
                                                    @foreach (var r in records)
                                                    {
                                                        var recView = (r.EffectiveActions & (int)GrantActions.View) != 0;
                                                        var recEdit = (r.EffectiveActions & (int)GrantActions.Edit) != 0;
                                                        var recReveal = (r.EffectiveActions & (int)GrantActions.RevealSecret) != 0;
                                                        <tr>
                                                            <td>@r.Title</td>
                                                            <td>@r.TemplateName</td>
                                                            <td>
                                                                <input type="checkbox" checked="@recView"
                                                                       @onchange="e => SetRecordAsync(row, r, GrantActions.View, e)" />
                                                            </td>
                                                            <td>
                                                                <input type="checkbox" checked="@recEdit"
                                                                       @onchange="e => SetRecordAsync(row, r, GrantActions.Edit, e)" />
                                                            </td>
                                                            <td>
                                                                <input type="checkbox" checked="@recReveal"
                                                                       @onchange="e => SetRecordAsync(row, r, GrantActions.RevealSecret, e)" />
                                                            </td>
                                                            <td>
                                                                @if (r.HasOverride)
                                                                {
                                                                    <button class="small" @onclick="() => RemoveOverrideAsync(row, r)">Heredar</button>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </section>
    }
}

@code {
    private IReadOnlyList<GroupsPageService.GroupRow>? _groups;
    private GroupsPageService.GroupDetail? _detail;
    private IReadOnlyList<GroupsPageService.ClientPermissionRow> _matrix = [];
    private IReadOnlyList<(Guid Id, string Name)> _users = [];
    private readonly Dictionary<Guid, IReadOnlyList<GroupsPageService.RecordPermissionRow>> _recordsByClient = [];
    private readonly HashSet<Guid> _openClients = [];
    private Guid? _selectedId;
    private string? _newName;
    private string? _newDescription;
    private string _memberToAdd = string.Empty;
    private string? _message;
    private bool _isError;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _groups = await Servicio.ListAsync();
        if (_groups is null)
            return;

        _users = await Servicio.UsersAsync();
    }

    private async Task CreateAsync()
    {
        _busy = true;
        try
        {
            var (id, error) = await Servicio.CreateAsync(_newName ?? string.Empty, _newDescription);
            if (id is null)
            {
                SetMessage(error ?? "No se pudo crear.", true);
                return;
            }

            _newName = _newDescription = null;
            SetMessage("Grupo creado.", false);
            await LoadAsync();
            await SelectAsync(id.Value);
        }
        finally { _busy = false; }
    }

    private async Task SelectAsync(Guid id)
    {
        _selectedId = id;
        _detail = await Servicio.DetailAsync(id);
        _openClients.Clear();
        _recordsByClient.Clear();
        _matrix = _detail is null ? [] : await Servicio.ClientsMatrixAsync(id);
    }

    private async Task AddMemberAsync()
    {
        if (_detail is null || !Guid.TryParse(_memberToAdd, out var userId))
        {
            SetMessage("Selecciona un usuario.", true);
            return;
        }

        var (ok, error) = await Servicio.AddMemberAsync(_detail.Id, userId);
        SetMessage(ok ? "Miembro añadido." : error ?? "No se pudo añadir.", !ok);
        _memberToAdd = string.Empty;
        await SelectAsync(_detail.Id);
    }

    private async Task RemoveMemberAsync(Guid userId)
    {
        if (_detail is null) return;
        var (ok, error) = await Servicio.RemoveMemberAsync(_detail.Id, userId);
        SetMessage(ok ? "Miembro quitado." : error ?? "No se pudo quitar.", !ok);
        await SelectAsync(_detail.Id);
    }

    private async Task SetClientAsync(GroupsPageService.ClientPermissionRow row, GrantActions action, ChangeEventArgs args)
    {
        if (_detail is null) return;

        var actions = row.Actions;
        if (args.Value is bool on && on) actions |= (int)action;
        else actions &= ~(int)action;

        var (ok, error) = await Servicio.SetClientActionsAsync(_detail.Id, row.ClientId, actions);
        if (!ok)
        {
            SetMessage(error ?? "No se pudo guardar.", true);
            return;
        }

        SetMessage("Permisos del cliente actualizados.", false);
        _matrix = await Servicio.ClientsMatrixAsync(_detail.Id);
    }

    private async Task ToggleRecordsAsync(GroupsPageService.ClientPermissionRow row)
    {
        if (_openClients.Remove(row.ClientId))
        {
            _recordsByClient.Remove(row.ClientId);
            return;
        }

        _openClients.Add(row.ClientId);
        if (_detail is not null)
            _recordsByClient[row.ClientId] = await Servicio.RecordsAsync(_detail.Id, row.ClientId, row.Actions);
    }

    private async Task SetRecordAsync(
        GroupsPageService.ClientPermissionRow row,
        GroupsPageService.RecordPermissionRow record,
        GrantActions action,
        ChangeEventArgs args)
    {
        if (_detail is null) return;

        var actions = record.EffectiveActions;
        if (args.Value is bool on && on) actions |= (int)action;
        else actions &= ~(int)action;

        var (ok, error) = await Servicio.SetRecordPermissionsAsync(_detail.Id, record.RecordId, actions);
        if (!ok)
        {
            SetMessage(error ?? "No se pudo guardar.", true);
            return;
        }

        SetMessage("Permisos de la ficha actualizados.", false);
        _recordsByClient[row.ClientId] = await Servicio.RecordsAsync(_detail.Id, row.ClientId, row.Actions);
    }

    private async Task RemoveOverrideAsync(GroupsPageService.ClientPermissionRow row, GroupsPageService.RecordPermissionRow record)
    {
        if (_detail is null) return;

        var (ok, error) = await Servicio.RemoveRecordOverrideAsync(_detail.Id, record.RecordId);
        if (!ok)
        {
            SetMessage(error ?? "No se pudo heredar.", true);
            return;
        }

        SetMessage("La ficha vuelve a heredar los permisos del cliente.", false);
        _recordsByClient[row.ClientId] = await Servicio.RecordsAsync(_detail.Id, row.ClientId, row.Actions);
    }

    private void SetMessage(string text, bool error)
    {
        _message = text;
        _isError = error;
    }
}
