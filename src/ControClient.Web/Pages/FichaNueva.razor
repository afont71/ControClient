@page "/clientes/{ClientId:guid}/fichas/nueva"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject FormPageService Fichas
@inject NavigationManager Nav

<PageTitle>Nueva ficha</PageTitle>

@if (_templates.Count == 0)
{
    <h1>Nueva ficha</h1>
    <p class="muted">No hay tipos de ficha activos. Un administrador debe crear uno.</p>
}
else
{
    <div class="form-panel">
        <header class="page-head">
            <div>
                <h1>@(_presetName is null ? "Nueva ficha" : $"Nueva {_presetName.ToLowerInvariant()}")</h1>
                <p class="subtitle">
                    @(_presetName is null
                        ? "Elige el tipo y rellena los campos."
                        : "Rellena los campos y guarda. La ficha quedará asociada al cliente.")
                </p>
            </div>
        </header>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        @if (_presetName is null)
        {
            <div class="form-grid">
                <label>
                    Tipo de ficha
                    <select @bind="_templateId" @bind:after="LoadFieldsAsync">
                        <option value="">Selecciona…</option>
                        @foreach (var t in _templates)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </label>

                <label>
                    Título
                    <input @bind="_title" placeholder="Nombre corto de la ficha" />
                </label>
            </div>
        }
        else if (_titleField is null)
        {
            <div class="form-grid">
                <label>
                    Título
                    <input @bind="_title" placeholder="Nombre corto de la ficha" />
                </label>
            </div>
        }

        @if (_fields.Count > 0)
        {
            <div class="form-grid">
                @foreach (var field in _fields)
                {
                    <div class="field @(field.Type is "LongText" ? "wide" : "")">
                        <label>
                            @field.Label @(field.Required ? "*" : "")
                            <span class="inline small">
                                <input type="checkbox" checked="@_secretFlag[field.Key]"
                                       disabled="@(!_canManageSecrecy)"
                                       title="@(_canManageSecrecy ? "Marcar o desmarcar secreto" : "Requiere permisos de bóveda")"
                                       @onchange="e => SetSecretFlag(field.Key, e)" />
                                Secreto
                            </span>
                            @if (_secretFlag[field.Key])
                            {
                                <input type="password" @bind="_secrets[field.Key]" autocomplete="new-password" placeholder="Valor secreto" />
                                <span class="muted small">Se guarda cifrado; solo se ve con permiso de revelar.</span>
                            }
                            else
                            {
                                @switch (field.Type)
                                {
                                    case "Boolean":
                                        <input type="checkbox" @bind="_bools[field.Key]" />
                                        break;
                                    case "Select":
                                        <select @bind="_text[field.Key]">
                                            <option value="">—</option>
                                            @foreach (var option in field.Options)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                        break;
                                    case "MultiSelect":
                                        <div class="checks">
                                            @foreach (var option in field.Options)
                                            {
                                                <label class="inline">
                                                    <input type="checkbox"
                                                           checked="@MultiContains(field.Key, option)"
                                                           @onchange="e => ToggleMulti(field.Key, option, e)" />
                                                    @option
                                                </label>
                                            }
                                        </div>
                                        break;
                                    case "LongText":
                                        <textarea class="long-text" rows="8" @bind="_text[field.Key]"></textarea>
                                        break;
                                    case "Number":
                                        <input type="number" step="any" @bind="_text[field.Key]" />
                                        break;
                                    case "Date":
                                        <input type="date" value="@TextOf(field.Key)" @onchange="e => _text[field.Key] = e.Value?.ToString()" />
                                        break;
                                    default:
                                        <input @bind="_text[field.Key]" />
                                        break;
                                }
                            }
                        </label>
                        @if (field.HelpText is not null)
                        {
                            <span class="muted small">@field.HelpText</span>
                        }
                        @if (_errors.TryGetValue(field.Key, out var messages))
                        {
                            <span class="error small">@string.Join(" ", messages)</span>
                        }
                    </div>
                }
            </div>

            <div class="form-actions">
                <button class="primary" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Guardando…" : "Guardar ficha")
                </button>
                <a class="button" href="@($"/datos/{ClientId}")">Cancelar</a>
            </div>
        }
        else if (!string.IsNullOrEmpty(_templateId))
        {
            <p class="muted">El tipo seleccionado no tiene campos.</p>
        }
    </div>
}

<p class="crumbs"><a href="@($"/datos/{ClientId}")">Volver a los datos del cliente</a></p>

@code {
    [Parameter] public Guid ClientId { get; set; }
    [SupplyParameterFromQuery] public Guid? TemplateId { get; set; }

    private IReadOnlyList<FormPageService.TemplateRow> _templates = [];
    private IReadOnlyList<FormPageService.FieldInfo> _fields = [];
    private readonly Dictionary<string, string?> _text = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, bool> _bools = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<string>> _multi = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _secrets = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, bool> _secretFlag = new(StringComparer.OrdinalIgnoreCase);
    private bool _canManageSecrecy;
    private Dictionary<string, string[]> _errors = new();
    private string _templateId = string.Empty;
    private string? _presetName;
    private string? _titleField;
    private string _title = string.Empty;
    private string? _error;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _templates = await Fichas.TemplatesAsync();
        _canManageSecrecy = await Fichas.CanManageSecrecyAsync(ClientId);

        if (TemplateId is Guid preset)
        {
            var template = _templates.FirstOrDefault(t => t.Id == preset);
            if (template is not null)
            {
                _templateId = preset.ToString();
                _presetName = template.Name;
                await LoadFieldsAsync();
            }
        }
    }

    private async Task LoadFieldsAsync()
    {
        _fields = [];
        _text.Clear();
        _bools.Clear();
        _multi.Clear();
        _errors = new();
        _titleField = null;

        if (!Guid.TryParse(_templateId, out var id))
            return;

        _presetName ??= _templates.FirstOrDefault(t => t.Id == id)?.Name;
        _fields = await Fichas.FieldsAsync(id);

        // Si el tipo tiene un campo que identifica la ficha (producto, nombre,
        // concepto…), se usa como título y no se pide dos veces.
        _titleField = _fields
            .Select(f => f.Key)
            .FirstOrDefault(k => new[] { "producto", "nombre", "concepto", "dominio", "titulo", "title" }
                .Contains(k, StringComparer.OrdinalIgnoreCase));

        foreach (var field in _fields)
        {
            _text[field.Key] = string.Empty;
            _bools[field.Key] = false;
            _secrets[field.Key] = string.Empty;
            _secretFlag[field.Key] = field.IsSecret;
        }
    }

    private string TextOf(string key) => _text.TryGetValue(key, out var value) ? value ?? string.Empty : string.Empty;

    private bool MultiContains(string key, string option) =>
        _multi.TryGetValue(key, out var list) && list.Contains(option);

    private void ToggleMulti(string key, string option, ChangeEventArgs args)
    {
        if (!_multi.TryGetValue(key, out var list))
        {
            list = [];
            _multi[key] = list;
        }

        if (args.Value is bool on && on)
        {
            if (!list.Contains(option)) list.Add(option);
        }
        else
        {
            list.Remove(option);
        }
    }

    private void SetSecretFlag(string key, ChangeEventArgs args)
    {
        var on = args.Value is bool value && value;
        _secretFlag[key] = on;

        if (on)
        {
            if (!string.IsNullOrWhiteSpace(_text.GetValueOrDefault(key)))
            {
                _secrets[key] = _text[key] ?? string.Empty;
                _text[key] = string.Empty;
            }
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(_secrets.GetValueOrDefault(key)))
            {
                _text[key] = _secrets[key];
                _secrets[key] = string.Empty;
            }
        }
    }

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(_templateId, out var templateId))
        {
            _error = "Selecciona un tipo de ficha.";
            return;
        }

        var title = _titleField is not null ? TextOf(_titleField) : _title;
        if (string.IsNullOrWhiteSpace(title))
        {
            _error = _titleField is not null
                ? $"El campo «{_fields.First(f => f.Key == _titleField).Label}» es obligatorio."
                : "El título es obligatorio.";
            return;
        }

        _saving = true;
        try
        {
            var (recordId, errors, error) = await Fichas.CreateAsync(
                ClientId, templateId, title, _fields, _text, _bools, _multi,
                _secrets.Where(s => !string.IsNullOrWhiteSpace(s.Value)).ToDictionary(s => s.Key, s => s.Value),
                _secretFlag);

            if (errors is not null)
            {
                _errors = errors;
                _error = "Revisa los campos marcados.";
                return;
            }

            if (recordId is null)
            {
                _error = error ?? "No se pudo crear la ficha.";
                return;
            }

            Nav.NavigateTo($"/datos/{ClientId}");
        }
        finally
        {
            _saving = false;
        }
    }
}
